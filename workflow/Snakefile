configfile: "config/config.yaml"

include: "rules/common.smk"
include: "rules/assembly.smk"
include: "rules/qc.smk"
include: "rules/decisions.smk"
include: "rules/blobtoolkit.smk"
include: "rules/decontamination.smk"
include: "rules/scaffolding.smk"
include: "rules/finalize.smk"
include: "rules/annotation.smk"


rule all:
    input:
        # Initial-stage QC (ploidy-aware: skip hap1/hap2 QC for polyploids)
        qc_initial_files(SPECIES, "assembly_stats"),
        qc_initial_files(SPECIES, "compleasm"),
        # Genomescope2 (reads-based, all species)
        expand(
            "results/{species}/qc/read/genomescope2/model/summary.txt",
            species=SPECIES,
        ),
        # Decisions
        expand(
            "results/{species}/decisions.yaml",
            species=SPECIES,
        ),
        # Initial blobtoolkit (per-species targets)
        all_decontamination_done(SPECIES),
        # Decontaminated assemblies + QC on them
        decontamination_targets_files(SPECIES, "fa"),
        decontamination_qc_files(SPECIES, "assembly_stats"),
        decontamination_qc_files(SPECIES, "compleasm"),
        # Aggregated report
        "results/aggregated/decontamination_report.html",
        "results/aggregated/decontamination_summary.tsv",
